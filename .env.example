# Copy to .env.local for local overrides. Do NOT commit .env.local — it is gitignored.

# Absolute origin used for canonical URLs, sitemap.xml, robots.txt, RSS, and OG tags.
# Leave unset locally (falls back to http://localhost:3000) and on Vercel preview
# deployments (falls back to the deployment URL).
# Set this in Vercel → Settings → Environment Variables once a custom domain is live:
# NEXT_PUBLIC_SITE_URL=https://lumivance.com
